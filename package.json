{
  "name": "@lipsjs/lips",
  "version": "0.2.0",
  "description": "Fast, Lightweight Reactive UI Framework",
  "main": "./dist/lips.min.js",
  "types": "./dist/types/lips.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/lips.d.ts",
      "import": "./dist/lips.min.js",
      "default": "./dist/lips.min.js"
    },
    "./dev": {
      "types": "./dist/types/lips.d.ts",
      "import": "./dist/lips.js",
      "default": "./dist/lips.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "import": "./dist/runtime.min.js",
      "default": "./dist/runtime.min.js"
    },
    "./precompile": {
      "types": "./dist/types/precompile.d.ts",
      "import": "./dist/precompile.min.js",
      "default": "./dist/precompile.min.js"
    }
  },
  "author": "Fabrice K.E.M",
  "private": false,
  "scripts": {
    "dev": "bun build --entrypoints ./src/lips.ts --entry-naming lips.min.[ext] --minify --outdir ./dist --target browser --format esm --sourcemap=external --watch",
    "build": "bun build --entrypoints ./src/lips.ts --entry-naming lips.min.[ext] --minify --outdir ./dist --target browser --format esm --sourcemap=external && bun build --entrypoints ./src/lips.ts --entry-naming lips.[ext] --outdir ./dist --target browser --format esm --sourcemap=external && bun build --entrypoints ./src/runtime.ts --entry-naming runtime.min.[ext] --minify --outdir ./dist --target browser --format esm --sourcemap=external && bun build --entrypoints ./src/precompile.ts --entry-naming precompile.min.[ext] --minify --outdir ./dist --target browser --format esm --sourcemap=external",
    "build:declaration": "tsc --project tsconfig.types.json",
    "compile": "bun run build",
    "typecheck": "tsc --project tsconfig.test.json",
    "prepack": "bun run build && bun run build:declaration",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-check.mjs"
  },
  "dependencies": {
    "stylis": "^4.3.4"
  },
  "devDependencies": {
    "@types/stylis": "^4.2.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "directories": {
    "dist": "dist/",
    "docs": "docs/",
    "test": "test/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/fabrice8/lips"
  },
  "keywords": []
}
