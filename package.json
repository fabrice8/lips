{
  "name": "@lipsjs/lips",
  "version": "0.1.2",
  "description": "Fast, Lightweight Reactive UI Framework",
  "main": "./dist/lips.min.js",
  "types": "./dist/types/lips.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/lips.d.ts",
      "import": "./dist/lips.min.js",
      "default": "./dist/lips.min.js"
    },
    "./dev": {
      "types": "./dist/types/lips.d.ts",
      "import": "./dist/lips.js",
      "default": "./dist/lips.js"
    }
  },
  "author": "Fabrice K.E.M",
  "private": false,
  "scripts": {
    "dev": "bun build --entrypoints ./test/* ./src/lips.ts --entry-naming [name].min.[ext] --minify --root . --outdir ./dist --target browser --format esm --sourcemap=external --watch",
    "build": "bun build --entrypoints ./src/lips.ts --entry-naming lips.min.[ext] --minify --outdir ./dist --target browser --format esm --sourcemap=external && bun build --entrypoints ./src/lips.ts --entry-naming lips.[ext] --outdir ./dist --target browser --format esm --sourcemap=external",
    "build:demos": "bun build --entrypoints ./test/* --entry-naming [name].min.[ext] --minify --root . --outdir ./dist --target browser --format esm --sourcemap=external",
    "build:declaration": "tsc --project tsconfig.types.json",
    "compile": "bun run build && bun run build:demos",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build && bun run build:declaration",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cash-dom": "^8.1.5",
    "stylis": "^4.3.4"
  },
  "devDependencies": {
    "@types/stylis": "^4.2.7",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "directories": {
    "dist": "dist/",
    "docs": "docs/",
    "test": "test/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/fabrice8/lips"
  },
  "keywords": []
}
